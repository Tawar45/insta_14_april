{% comment %}
  AI Instafeed — Story Layout Block
  Self-contained: loads CSS + JS directly so it works with or without the app-embed block.
{% endcomment %}

<style>
  [data-block-handle="story-layout"] {
    width: 100% !important;
  }
</style>

<div style="width: 100% !important;">
  <instafeed-story css-url="{{ 'instafeed-front.css' | asset_url }}" data-logo-url="{{ 'logo.png' | asset_url }}"></instafeed-story>
</div>
<script src="{{ 'instafeed-front.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Instafeed: Story Layout",
  "target": "section",
  "settings": []
}
{% endschema %}
